@model ClinicManager.DTOs.ManageRolesDto
@{
    ViewData["Title"] = "Manage";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="d-flex align-items-center mb-4">
            <a asp-action="Users" class="btn btn-sm btn-outline-secondary me-3" id="manage-roles-back">
                ← Back
            </a>
            <div>
                <h1 class="h4 fw-bold mb-0">🔑 Manage User</h1>
                <p class="text-muted small mb-0">@Model.FullName (@Model.UserName)</p>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-action="ManageRoles" method="post">
                    <input type="hidden" asp-for="UserId" />
                    <input type="hidden" asp-for="UserName" />
                    <input type="hidden" asp-for="FullName" />

                    <p class="fw-semibold mb-3">Select roles for this user:</p>

                    @for (int i = 0; i < Model.AllRoles.Count; i++)
                    {
                        var role = Model.AllRoles[i];
                        var isChecked = Model.CurrentRoles.Contains(role);
                        var badgeClass = role switch
                        {
                            "Admin" => "text-danger",
                            "Doctor" => "text-primary",
                            "Receptionist" => "text-success",
                            _ => "text-secondary"
                        };

                        <div class="form-check mb-3">
                            <input class="form-check-input"
                                   type="checkbox"
                                   name="SelectedRoles"
                                   value="@role"
                                   id="role-@role"
                                   @(isChecked ? "checked" : "") />
                            <label class="form-check-label fw-semibold @badgeClass" for="role-@role">
                                @role
                            </label>
                        </div>
                    }

                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-primary" id="manage-roles-submit">
                            Save Changes
                        </button>
                    </div>
                </form>

                <hr class="my-4" />

                <div class="d-grid">
                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteUserModal" id="delete-user-btn">
                        🗑️ Delete User
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteUserModal" tabindex="-1" aria-labelledby="deleteUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold" id="deleteUserModalLabel">🗑️ Delete User</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">Are you sure you want to delete <strong>@Model.FullName</strong> (@Model.UserName)?</p>
                <p class="text-danger small mt-2 mb-0">This action cannot be undone.</p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="DeleteUser" method="post" class="d-inline">
                    <input type="hidden" name="userId" value="@Model.UserId" />
                    <button type="submit" class="btn btn-danger" id="delete-user-confirm">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>
