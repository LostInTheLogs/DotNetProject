@model ClinicManager.Models.MedicalProcedure
@{
    ViewData["Title"] = "Add Procedure";
}

<div class="row justify-content-center mt-3">
    <div class="col-md-7">
        <div class="d-flex align-items-center mb-3">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary me-3">← Back</a>
            <h5 class="fw-bold mb-0">Register Catalog Procedure</h5>
        </div>
        
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label small fw-semibold"></label>
                        <input asp-for="Name" class="form-control form-control-sm" placeholder="e.g., Abdominal Ultrasound" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label small fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control form-control-sm" rows="3" placeholder="Enter details..." maxlength="500" required></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ServiceCost" class="form-label small fw-semibold"></label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text">$</span>
                            <input asp-for="ServiceCost" type="number" step="0.01" class="form-control" placeholder="0.00" required />
                        </div>
                        <span asp-validation-for="ServiceCost" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-sm btn-primary px-4 py-2 fw-semibold">Save Catalog Entity</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
